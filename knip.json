  "entry": ["src/app/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "@google/genai",
    "@googlemaps/js-api-loader",
    "@tailwindcss/postcss",
    "@testing-library/jest-dom",
