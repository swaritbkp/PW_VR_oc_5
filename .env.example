# Server-only (Secret Manager on Cloud Run). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_PLACES_API_KEY=
RATE_LIMIT_PER_MIN=10
# The ONLY public key: restrict by HTTP referrer AND to the Maps JavaScript API, and cap quota.
NEXT_PUBLIC_MAPS_BROWSER_KEY=

# Server-only auth (NextAuth.js v4 JWT sessions). Never prefix with NEXT_PUBLIC_.
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe billing (pro-tier stub; no live calls until keys configured).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Persistent database (Prisma + PostgreSQL).
DATABASE_URL=
